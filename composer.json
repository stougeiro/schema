{
    "name": "stougeiro/schema",
    "description": "A lightweight structural gate for PHP payloads. Validates the shape before business logic validates the content.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "schema",
        "validation",
        "structure",
        "gate",
        "payload",
        "type-safe",
        "typed",
        "nested",
        "error-message",
        "php",
        "data"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/schema/issues",
        "source": "https://github.com/stougeiro/schema"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Schema\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "require": {
        "php": ">=8.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
