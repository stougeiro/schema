{
    "name": "stougeiro/schema",
    "description": "A lightweight foundation for defining and validating structured schemas in PHP.",
    "type": "package",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "schema",
        "typed schema",
        "validation",
        "structure",
        "typed",
        "data",
        "php",
        "design",
        "architecture",
        "data modeling",
        "domain",
        "ddd",
        "clean"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/schema/issues",
        "source": "https://github.com/stougeiro/schema"
    },
    "autoload": {
        "psr-4": {
            "STDW\\Schema\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    }
}
